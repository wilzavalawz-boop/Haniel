<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Con todo el corazón · Haniel, mi primer disco</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Nunito:wght@400;600;700&family=Pacifico&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#f5f0e3; --paper:#fffcf4; --ink:#34322d; --soft:#736e63; --line:#e4dcc7;
  --purple:#6f45ad; --orange:#d9650f; --teal:#1f857b; --green:#3a8034; --blue:#1f5a96;
  --w-purple:#ebe2f5; --w-orange:#fbe6cc; --w-teal:#d4ede9; --w-green:#e3efc9;
  --vinyl:#2a2826; --groove:#3a3734; --on-accent:#fffcf4;
  box-sizing:border-box; color-scheme:light;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#1d1b18; --paper:#292723; --ink:#f2ede1; --soft:#b9b2a3; --line:#3e3a33;
  --purple:#c2a3ee; --orange:#f4aa66; --teal:#7dd3c8; --green:#9dcf87; --blue:#8bb8ea;
  --w-purple:#382f46; --w-orange:#44352a; --w-teal:#243f3b; --w-green:#323e29;
  --vinyl:#0f0e0d; --groove:#2a2826; --on-accent:#1d1b18; color-scheme:dark;
}}
:root[data-theme="dark"]{
  --bg:#1d1b18; --paper:#292723; --ink:#f2ede1; --soft:#b9b2a3; --line:#3e3a33;
  --purple:#c2a3ee; --orange:#f4aa66; --teal:#7dd3c8; --green:#9dcf87; --blue:#8bb8ea;
  --w-purple:#382f46; --w-orange:#44352a; --w-teal:#243f3b; --w-green:#323e29;
  --vinyl:#0f0e0d; --groove:#2a2826; --on-accent:#1d1b18; color-scheme:dark;
}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{margin:0;background:var(--bg);color:var(--ink);font-family:Nunito,"Trebuchet MS",system-ui,sans-serif;line-height:1.55}
h1,h2,h3{font-family:"Baloo 2","Chalkboard SE","Comic Sans MS",system-ui,sans-serif;line-height:1.02;margin:0}
img,video{max-width:100%;display:block}
main{max-width:980px;margin:0 auto;padding:28px 18px 56px}
button{font:inherit}

/* Portada */
.cover{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:56px;align-items:center;margin-bottom:56px}
.sleeve{position:relative;aspect-ratio:4/5;max-width:430px;width:100%;justify-self:center}
.sleeve .disc{position:absolute;width:74%;top:14%;right:0}
.sleeve .pic{position:relative;z-index:1;width:78%;aspect-ratio:4/5;border-radius:18px;overflow:hidden;box-shadow:0 16px 32px -18px rgba(40,30,10,.6);transform:rotate(-3deg)}
.sleeve .pic img{width:100%;height:100%;object-fit:cover}
.cover .artist{font-family:Pacifico,"Brush Script MT","Segoe Script",cursive;font-size:clamp(3rem,8.5vw,4.4rem);line-height:1.2;font-weight:400;color:var(--blue);margin:0 0 24px;padding-bottom:16px;border-bottom:3px dotted var(--line);max-width:none}
.cover h1{font-size:clamp(2.7rem,7.5vw,4.4rem);font-weight:800;color:var(--purple);margin:2px 0 10px}
.cover h1 .l2{display:block;color:var(--orange)}
.edition{display:inline-block;border:2px solid var(--line);border-radius:999px;padding:3px 14px;font-weight:700;color:var(--soft);margin-bottom:16px}
.cover p{color:var(--soft);margin:0 0 20px;max-width:34ch}
.all{display:inline-flex;align-items:center;gap:10px;border:0;border-radius:999px;background:var(--ink);color:var(--bg);font-weight:700;padding:12px 22px 12px 16px;cursor:pointer}
.all span{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:var(--orange);color:var(--on-accent);font-size:.85rem}
.all:focus-visible,.play:focus-visible,.vbtn:focus-visible{outline:3px solid var(--purple);outline-offset:3px}

/* Disco */
.disc{position:relative;border-radius:50%;aspect-ratio:1;background:
  radial-gradient(circle at 50% 50%, var(--lab,var(--orange)) 0 17%, var(--vinyl) 17.5% 19%, transparent 19%),
  repeating-radial-gradient(circle at 50% 50%, var(--vinyl) 0 3px, var(--groove) 3px 4px)}
.disc::after{content:"";position:absolute;left:50%;top:50%;width:3%;height:3%;border-radius:50%;background:var(--bg);transform:translate(-50%,-50%)}
.spin{animation:spin 2.4s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
@media (prefers-reduced-motion:reduce){.spin{animation:none}}

/* Lista de canciones */
.tracks{background:var(--paper);border:1px solid var(--line);border-radius:20px;padding:22px 24px;margin:0 0 64px}
.tracks h2{font-size:1.6rem;margin-bottom:12px}
.group{margin-top:12px}
.group h3{font-family:Nunito,system-ui,sans-serif;font-size:.8rem;letter-spacing:.06em;text-transform:uppercase;color:var(--soft);font-weight:700;margin-bottom:4px}
.tracks ol{list-style:none;margin:0;padding:0}
.tracks li a{display:flex;align-items:baseline;gap:12px;padding:6px 0;color:inherit;text-decoration:none;border-bottom:1px dashed var(--line)}
.tracks li a:hover .t{text-decoration:underline;text-underline-offset:3px}
.tracks .n{font-family:"Baloo 2",system-ui,sans-serif;font-weight:800;color:var(--c);width:1.4em}
.tracks .t{flex:1;font-weight:700}
.tracks .d{color:var(--soft);font-variant-numeric:tabular-nums;font-size:.9rem}

/* Canción */
.song{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6fr);gap:34px;align-items:center;margin-bottom:72px}
.song.flip .media{order:2}
.media{position:relative}
.media .frame{position:relative;z-index:1;border-radius:20px;overflow:hidden;aspect-ratio:4/5;background:var(--paper);box-shadow:0 14px 30px -20px rgba(40,30,10,.55)}
.media .frame img,.media .frame video{width:100%;height:100%;object-fit:cover}
.media .frame video{background:var(--ink);object-fit:cover}
.media .disc{position:absolute;width:60%;right:-12%;bottom:-8%;z-index:0}
.song.flip .media .disc{right:auto;left:-12%}
.kicker{font-weight:700;color:var(--soft);margin:0 0 2px}
.kicker b{color:var(--c)}
.song h2{font-size:clamp(2.2rem,5.5vw,3.1rem);color:var(--c)}
.song h3{font-size:1.4rem;font-weight:700;margin:4px 0 16px}
.lyrics{border-left:5px solid var(--c);background:var(--w);border-radius:0 16px 16px 0;padding:14px 18px;margin:0 0 18px}
.lyrics p{margin:0 0 6px;font-family:"Baloo 2",system-ui,sans-serif;font-size:1.5rem;font-weight:700;line-height:1.2}
.lyrics p:last-child{margin:0}
.memo{color:var(--soft);font-style:italic;margin:14px 0 0}

.player{display:flex;align-items:center;gap:14px}
.play{flex:none;width:58px;height:58px;border-radius:50%;border:0;background:var(--c);color:var(--on-accent);font-size:1.3rem;cursor:pointer;display:grid;place-items:center}
.track{flex:1;min-width:0}
.track b{display:block}
.bar{height:8px;border-radius:4px;background:var(--line);overflow:hidden;margin-top:6px}
.bar i{display:block;height:100%;width:0;background:var(--c)}
.vbtn{margin-top:14px;display:inline-flex;align-items:center;gap:8px;border:2px solid var(--c);background:transparent;color:var(--ink);border-radius:999px;padding:7px 16px;font-weight:700;cursor:pointer}

/* Instrumentos */
.inst{background:var(--paper);border:1px solid var(--line);border-radius:24px;padding:28px 24px;margin-bottom:40px}
.inst h2{font-size:clamp(2rem,5vw,2.6rem);color:var(--blue);text-align:center}
.inst p{text-align:center;color:var(--soft);margin:6px 0 20px}
.gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.gallery figure{margin:0}
.gallery img{border-radius:16px;aspect-ratio:4/5;width:100%;object-fit:cover}
.gallery figcaption{text-align:center;font-family:"Baloo 2",system-ui,sans-serif;font-weight:700;font-size:1.25rem;margin-top:8px}
footer{text-align:center;color:var(--soft);font-size:.95rem}

@media (max-width:720px){
  .cover,.song{grid-template-columns:1fr}
  .song.flip .media{order:0}
  .media{max-width:360px;width:86%;margin:0 auto 8px}
  .cover{text-align:center}.cover p{margin:0 auto 20px}
}
</style>
</head>
<body>
<main>

<section class="cover">
  <div class="sleeve">
    <div class="disc" id="d-cover" style="--lab:var(--orange)"></div>
    <div class="pic"><img src="data:image/webp;base64," alt="Haniel con las baquetas en alto, sentado frente a su batería morada"></div>
  </div>
  <div>
    <p class="artist">Haniel</p>
    <h1>Con todo<span class="l2">el corazón</span></h1>
    <div class="edition">Mi primer disco · Canciones de mis 2 años</div>
    <p>Canto con los ojos cerrados, el ceño fruncido y mucha energía… ¡y con la cara feliz! Me sé muchas canciones; estas son las que mis papás han podido guardar.</p>
    <button class="all" id="all"><span>▶</span><em style="font-style:normal">Escuchar el disco completo</em></button>
  </div>
</section>

<nav class="tracks" aria-label="Canciones del disco">
  <h2>Mis canciones</h2>
  <div class="group"><h3>Canción infantil</h3><ol>
    <li style="--c:var(--orange)"><a href="#estrellita"><span class="n">1</span><span class="t">Estrellita, ¿dónde estás?</span><span class="d">0:10</span></a></li>
  </ol></div>
  <div class="group"><h3>Canciones de mi iglesia</h3><ol>
    <li style="--c:var(--purple)"><a href="#vamos"><span class="n">2</span><span class="t">Vamos a cantar</span><span class="d">0:20</span></a></li>
    <li style="--c:var(--teal)"><a href="#heme"><span class="n">3</span><span class="t">Heme aquí</span><span class="d">0:13</span></a></li>
  </ol></div>
  <div class="group"><h3>Canción folclórica</h3><ol>
    <li style="--c:var(--green)"><a href="#candu"><span class="n">4</span><span class="t">Candú</span><span class="d">0:11</span></a></li>
  </ol></div>
</nav>

<section class="song" id="estrellita" style="--c:var(--orange);--w:var(--w-orange)">
  <div class="media">
    <div class="disc" id="d-estrellita" style="--lab:var(--orange)"></div>
    <div class="frame"><img src="data:image/webp;base64," alt="Haniel con su guitarra de juguete"></div>
  </div>
  <div>
    <p class="kicker"><b>Pista 1</b> · Canción infantil</p>
    <h2>Así la canto</h2>
    <h3>Estrellita, ¿dónde estás?</h3>
    <div class="lyrics"><p>Etellita donde tá</p><p>quero verte ti ti lar</p></div>
    <div class="player" data-track="estrellita">
      <button class="play" aria-label="Escuchar Estrellita">▶</button>
      <div class="track"><b>Mi voz · 0:10</b><div class="bar"><i></i></div></div>
    </div>
    <button class="vbtn" data-video="estrellita">🎬 Ver video</button>
    <p class="memo">La canto mirando hacia arriba, como buscando la estrellita.</p>
  </div>
</section>

<section class="song flip" id="vamos" style="--c:var(--purple);--w:var(--w-purple)">
  <div class="media">
    <div class="disc" id="d-vamos" style="--lab:var(--purple)"></div>
    <div class="frame"><img src="data:image/webp;base64," alt="Haniel tocando su batería con una baqueta en alto"></div>
  </div>
  <div>
    <p class="kicker"><b>Pista 2</b> · Canción de mi iglesia</p>
    <h2>Así la canto</h2>
    <h3>Vamos a cantar</h3>
    <div class="lyrics"><p>Vamo a canta alegues</p><p>poque scuchas cando cam ca mos</p><p>paa echatá tu nome</p></div>
    <div class="player" data-track="vamos">
      <button class="play" aria-label="Escuchar Vamos a cantar">▶</button>
      <div class="track"><b>Mi voz · 0:20</b><div class="bar"><i></i></div></div>
    </div>
    <button class="vbtn" data-video="vamos">🎬 Ver video</button>
    <p class="memo">La canto tocando mi batería, y al final me río.</p>
  </div>
</section>

<section class="song" id="heme" style="--c:var(--teal);--w:var(--w-teal)">
  <div class="media">
    <div class="disc" id="d-heme" style="--lab:var(--teal)"></div>
    <div class="frame"><img src="data:image/webp;base64," alt="Haniel cantando mientras toca el platillo de su batería"></div>
  </div>
  <div>
    <p class="kicker"><b>Pista 3</b> · Canción de mi iglesia</p>
    <h2>Así la canto</h2>
    <h3>Heme aquí</h3>
    <div class="lyrics"><p>He aquí envíame mi yo</p><p>queo canta o que hecho po mi</p></div>
    <div class="player" data-track="heme">
      <button class="play" aria-label="Escuchar Heme aquí">▶</button>
      <div class="track"><b>Mi voz · 0:13</b><div class="bar"><i></i></div></div>
    </div>
  </div>
</section>

<section class="song flip" id="candu" style="--c:var(--green);--w:var(--w-green)">
  <div class="media">
    <div class="disc" id="d-candu" style="--lab:var(--green)"></div>
    <div class="frame"><img src="data:image/webp;base64," alt="Haniel tocando su guitarra de luces"></div>
  </div>
  <div>
    <p class="kicker"><b>Pista 4</b> · Canción folclórica</p>
    <h2>Así la canto</h2>
    <h3>Candú</h3>
    <div class="lyrics"><p>Eita amate mi coachón mi coachón,</p><p>eita amate mi coachón mi coachón,</p><p>cantú cantú cantú</p></div>
    <div class="player" data-track="candu">
      <button class="play" aria-label="Escuchar Candú">▶</button>
      <div class="track"><b>Mi voz · 0:11</b><div class="bar"><i></i></div></div>
    </div>
  </div>
</section>

<section class="inst">
  <h2>Mis instrumentos</h2>
  <p>Con ellos acompaño mis canciones</p>
  <div class="gallery">
    <figure><img src="data:image/webp;base64," alt="Haniel tocando su batería morada"><figcaption>🥁 Mi batería</figcaption></figure>
    <figure><img src="data:image/webp;base64," alt="Haniel tocando su guitarra de juguete con luces"><figcaption>🎸 Mi guitarra</figcaption></figure>
  </div>
</section>

<footer>Guardado en noviembre 2026, para ver en 10 años.</footer>
</main>

<script type="application/json" id="media">{"a_estrellita":"","a_vamos":"","a_heme":"","a_candu":"","v_estrellita":"","v_vamos":"","p_vamos":"data:image/webp;base64,","p_estrellita":"data:image/webp;base64,"}</script>
<script>
(function(){
  var M=JSON.parse(document.getElementById('media').textContent), urls={};
  function url(key,type){
    if(!urls[key]){
      var bin=atob(M[key]), a=new Uint8Array(bin.length);
      for(var i=0;i<bin.length;i++)a[i]=bin.charCodeAt(i);
      urls[key]=URL.createObjectURL(new Blob([a],{type:type}));
    }
    return urls[key];
  }
  var order=['estrellita','vamos','heme','candu'], audios={}, players={}, queue=null;
  var allBtn=document.getElementById('all'), coverDisc=document.getElementById('d-cover');
  function stopVideos(){document.querySelectorAll('video').forEach(function(v){v.pause()})}
  function stopOthers(k){Object.keys(audios).forEach(function(o){if(o!==k&&!audios[o].paused)audios[o].pause()})}
  function audio(k){
    if(audios[k])return audios[k];
    var au=new Audio(url('a_'+k,'audio/mp4')), p=players[k];
    var btn=p.querySelector('.play'), bar=p.querySelector('.bar i'), disc=document.getElementById('d-'+k);
    au.addEventListener('play',function(){btn.textContent='❚❚';disc.classList.add('spin');if(queue!==null)coverDisc.classList.add('spin')});
    au.addEventListener('pause',function(){btn.textContent='▶';disc.classList.remove('spin')});
    au.addEventListener('timeupdate',function(){if(au.duration)bar.style.width=(au.currentTime/au.duration*100)+'%'});
    au.addEventListener('ended',function(){bar.style.width='0';
      if(queue!==null){queue++; if(queue<order.length){playTrack(order[queue],true)}else{endQueue()}}});
    audios[k]=au; return au;
  }
  function playTrack(k,scroll){
    stopVideos(); stopOthers(k); var au=audio(k); au.currentTime=0; au.play();
    if(scroll)document.getElementById(k).scrollIntoView({block:'center'});
  }
  function endQueue(){queue=null;coverDisc.classList.remove('spin');allBtn.querySelector('span').textContent='▶';allBtn.querySelector('em').textContent='Escuchar el disco completo'}
  document.querySelectorAll('.player').forEach(function(p){
    var k=p.dataset.track; players[k]=p;
    p.querySelector('.play').addEventListener('click',function(){
      var au=audio(k);
      if(au.paused){if(queue!==null)endQueue();stopVideos();stopOthers(k);au.play()}else{au.pause();if(queue!==null)endQueue()}
    });
  });
  allBtn.addEventListener('click',function(){
    if(queue!==null){Object.keys(audios).forEach(function(o){audios[o].pause()});endQueue();return}
    queue=0; allBtn.querySelector('span').textContent='❚❚'; allBtn.querySelector('em').textContent='Pausar el disco';
    playTrack(order[0],true);
  });
  document.querySelectorAll('.vbtn').forEach(function(b){
    var k=b.dataset.video, frame=document.querySelector('#'+k+' .frame'), img=frame.querySelector('img'), v=null;
    b.addEventListener('click',function(){
      if(v){v.pause();v.remove();v=null;img.style.display='';b.textContent='🎬 Ver video';return}
      Object.keys(audios).forEach(function(o){audios[o].pause()}); if(queue!==null)endQueue();
      v=document.createElement('video'); v.poster=M['p_'+k]; v.src=url('v_'+k,'video/mp4'); v.controls=true; v.playsInline=true; v.setAttribute('playsinline','');
      img.style.display='none'; frame.appendChild(v); v.play().catch(function(){});
      b.textContent='📷 Ver foto';
    });
  });
})();
</script>
</body>
</html>
